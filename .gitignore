# Large media files — too big for GitHub (use cloud storage instead)
agrisense/frontend/public/hero.mp4
agrisense/frontend/public/*.mp4
agrisense/frontend/public/*.mov
agrisense/frontend/public/*.avi

# ── Kiro IDE files ───────────────────────────────────────────
.kiro/

# VS Code settings
.vscode/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
agrisense/backend/venv/
agrisense/backend/.venv/

# ── Secrets — NEVER commit these ────────────────────────────
agrisense/backend/.env
agrisense/frontend/.env.local
.env
.env.local
.env.*.local

# ── ML model binaries (regenerated by train_models.py) ──────
agrisense/backend/app/ml_models/*.pkl

